# Public build-time values. Configure these in the chosen standalone host's build environment.
# A domain-ready game requires only HISAAB_BASE=/; advertising is independently disabled.
HISAAB_BASE=/
HISAAB_OUT=dist-hisaab-domain
HISAAB_ADS_ENABLED=false
HISAAB_ADS_SITE_APPROVED=false
HISAAB_ADS_AUTO_ADS_DISABLED=false
HISAAB_ADS_ORIGIN=
HISAAB_ADS_CLIENT=
HISAAB_ADS_HOME_SLOT=
HISAAB_ADS_CMP_ID=
# Optional completed-game H5 placements. Keep false without actual H5 publisher/site approval.
HISAAB_ADS_H5_ENABLED=false
HISAAB_ADS_H5_APPROVED=false
# Use provider test creatives only in the approved test build; false for a public release.
HISAAB_ADS_H5_TEST=false
